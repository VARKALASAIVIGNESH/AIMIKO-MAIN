# AIMIKO backend environment (copy to .env and adjust)

# App
ENVIRONMENT=development
DEBUG=false

# Database: PostgreSQL (Supabase / Neon in production, SQLite for local dev)
DATABASE_URL=sqlite:///./aimiko.db
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Credentials (optional for direct storage / auth hooks)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments (Razorpay for INR, Stripe for Global)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Authentication (change in production)
JWT_SECRET_KEY=aimiko-change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_SECURE=false

# CORS
FRONTEND_ORIGINS=["http://localhost:3000"]

# Bootstrap admin
ADMIN_EMAIL=admin@aimiko.ai
ADMIN_PASSWORD=AimikoAdmin123!
ADMIN_FULL_NAME=AIMIKO Admin

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
# STORAGE_BACKEND=s3
# STORAGE_S3_BUCKET=aimiko-storage
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# Redis (optional; used only if a job/queue system is enabled)
REDIS_URL=redis://localhost:6379/0

# Open-source engines (integration happens per phase)
ENGINE_ACTIVEPIECES_URL=http://localhost:3001
ENGINE_DOCUMENT_CHAT_URL=http://localhost:8010
ENGINE_DOGRAH_URL=http://localhost:8020
ENGINE_AI_INFRA_GUARD_URL=http://localhost:8030
ENGINE_CVAT_URL=http://localhost:8080
ENGINE_OPENCV_AVAILABLE=true

# LLM provider (leave empty to use development fallback)
LLM_PROVIDER=
LLM_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o-mini
